# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (SQLite for local zero-config, PostgreSQL for production Docker)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://leetadmin:leetsecret123@localhost:5432/leettracker?schema=public"

# Authentication Secrets
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_characters"
JWT_REFRESH_SECRET="replace_with_a_secure_random_refresh_secret_min_32_characters"

# Self-Hosted Email Service (SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LeetTracker Pro <no-reply@leettracker.io>"

# Stripe Payment Gateway & Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOCK_MODE=true
