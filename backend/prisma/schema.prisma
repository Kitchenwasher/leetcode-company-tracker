// Prisma Schema for LeetTracker Pro (PostgreSQL for Neon and Production)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String?
  googleId             String?        @unique
  githubId             String?        @unique
  leetcodeUsername     String?
  name                 String
  avatarUrl            String?
  tier                 String         @default("free") // "free", "pro", "enterprise"
  targetCompany        String         @default("google")
  targetDate           String?
  dailyTarget          Int            @default(3)
  emailVerified        Boolean        @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  progress             UserProgress[]
  activities           ActivityLog[]
  payments             Payment[]
  emailLogs            EmailLog[]
  communityPosts       CommunityPost[]
  communityComments    CommunityComment[]
  communityUpvotes     CommunityUpvote[]
  mockSessions         MockInterviewSession[]
}

model Question {
  id            Int               @id
  title         String
  difficulty    String            // "Easy", "Medium", "Hard"
  acceptance    String
  url           String
  topics        String            // JSON string array: ["Array", "Dynamic Programming"]
  isBlind75     Boolean           @default(false)
  isNeetCode150 Boolean           @default(false)
  isStriver180  Boolean           @default(false)
  isGrind169    Boolean           @default(false)
  descriptionContent String?      // Cached LeetCode problem HTML description
  exampleTestcases   String?      // Cached JSON string array of testcases
  codeSnippets       String?      // Cached JSON string array of { lang, langSlug, code }
  createdAt     DateTime          @default(now())

  solution      Solution?
  companies     QuestionCompany[]
  userProgress  UserProgress[]
}

model QuestionCompany {
  questionId     Int
  companyId      String
  allFreq        String?
  thirtyDaysFreq String?
  threeMonthsFreq String?
  sixMonthsFreq  String?
  twoYearsFreq   String?

  question       Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, companyId])
}

model Solution {
  id            Int       @id @default(autoincrement())
  questionId    Int       @unique
  corePattern   String
  interviewTips String    // JSON string array of tips
  approaches    String    // JSON string array of multi-approach C++ solutions & theory

  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model UserProgress {
  userId             String
  questionId         Int
  status             String    @default("todo") // "todo", "in_progress", "solved", "review", "mastered"
  isFavorite         Boolean   @default(false)
  confidence         Int       @default(0)
  personalDifficulty String?
  notes              String?
  tags               String?   // JSON string array: ["#Graph", "#DFS"]
  timeSpentSeconds   Int       @default(0)
  solveCount         Int       @default(0)
  lastSolvedAt       DateTime?
  nextReviewAt       DateTime?
  reviewIntervalDays Int       @default(1)
  whiteboardData     String?   // JSON canvas strokes
  codeSnippet        String?   // JSON { lang, code }
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question           Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     String
  date       String   // "YYYY-MM-DD"
  solveCount Int      @default(0)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Payment {
  id              String   @id @default(uuid())
  userId          String?
  payerEmail      String?
  stripeSessionId String?  @unique
  amount          Int      // Amount in cents (900 = $9.00)
  currency        String   @default("usd")
  status          String   // "succeeded", "pending", "failed"
  plan            String   // "pro_monthly", "pro_yearly", "pro_lifetime"
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id           String   @id @default(uuid())
  userId       String?
  recipient    String
  subject      String
  template     String
  status       String   // "sent", "failed"
  errorMessage String?
  sentAt       DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CommunityPost {
  id           String             @id @default(uuid())
  userId       String
  title        String
  content      String             // Markdown / text content
  category     String             // "interview_experience", "question_help", "general", "compensation"
  companyId    String?            // e.g. "google", "amazon"
  questionId   Int?
  tags         String             @default("[]") // JSON string array of tags
  upvotesCount Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     CommunityComment[]
  upvotes      CommunityUpvote[]

  @@index([category])
  @@index([companyId])
  @@index([createdAt])
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime      @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model CommunityUpvote {
  userId    String
  postId    String
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model MockInterviewSession {
  id              String   @id @default(uuid())
  userId          String
  company         String
  role            String   @default("SWE Candidate")
  type            String   // "Coding", "Behavioral", "Mixed"
  difficulty      String?  // "Easy", "Medium", "Hard", "Mixed"
  score           Int      // 0 to 100
  durationMinutes Int
  solvedCount     Int
  totalQuestions  Int
  feedback        String?
  questionsData   String   @default("[]") // JSON representation of questions/prompts & results
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

