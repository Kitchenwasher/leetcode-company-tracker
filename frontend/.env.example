# API Endpoints Configuration
# In production on Vercel:
# VITE_API_URL: Primary backend URL (e.g. AWS Lightsail or your brother's subdomain https://api.yourdomain.com)
# VITE_FALLBACK_API_URL: Fallback backend URL on Railway (e.g. https://your-backend.up.railway.app)
# VITE_API_TIMEOUT_MS: Maximum time in ms to wait for primary before switching to Railway (default 2500)

VITE_API_URL=http://localhost:5000
VITE_FALLBACK_API_URL=
VITE_API_TIMEOUT_MS=2500
